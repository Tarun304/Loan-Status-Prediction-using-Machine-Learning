# Virtual Environment
venv/
*.pyc
__pycache__/

# Data files - BLOCK CSV, ALLOW DVC metadata
/data/raw/*.csv
/data/interim/*.csv
/data/processed/*.csv
/data/features/*.csv
!*.dvc
!.dvc/

# Model files - BLOCK models, ALLOW DVC metadata
/models/*.pkl
/models/*.joblib
/models/*.h5
/models/artifacts/*
!*.dvc

# Reports - BLOCK contents, ALLOW DVC metadata
/reports/*
!reports/*.json
!reports/*.dvc
!*.dvc

# DVC cache (remote storage)
.dvc/cache
.dvc/tmp

# MLflow tracking
mlruns/
mlartifacts/

# Jupyter notebooks
.ipynb_checkpoints/

# OS generated
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/

# Logs
*.log

# Environment variables
.env
.env.*

# Documents (your MS Word + PDF)
*.docx
*.pdf
Case_Study*.docx
Report_*.pdf
